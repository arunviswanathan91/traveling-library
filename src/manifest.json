{
  "manifest_version": 2,
  "name": "Traveling Library",
  "version": "0.3.0",
  "description": "Import embedded EndNote references from Word documents into a selected Zotero collection.",
  "author": "Arun Viswanathan",
  "homepage_url": "https://github.com/arunviswanathan91/traveling-library",
  "applications": {
    "zotero": {
      "id": "traveling-library@arunviswanathan91",
      "strict_min_version": "7.0",
      "strict_max_version": "10.0.*",
      "update_url": "https://raw.githubusercontent.com/arunviswanathan91/traveling-library/main/updates.json"
    }
  }
}
